{
  "info": {
    "_postman_id": "8c8f6434-2534-4b42-9655-d9a280a6d0cd",
    "name": "ApiCadastro - CRUD Pessoas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection para testar o CRUD de pessoas (cpf, nome e idade) na API Spring Boot com H2.\n\nOs CPFs usados nos exemplos sao validos pelo digito verificador e seguem o formato aceito pela API: 11 digitos, sem pontuacao.\n\nOrdem sugerida: rode os POSTs da pasta \"CRUD\" primeiro. O primeiro POST guarda o id retornado na variavel {{id}}, usada pelos requests seguintes."
  },
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "POST - Criar pessoa (Maria)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var pessoa = pm.response.json();",
                  "pm.collectionVariables.set(\"id\", pessoa.id);",
                  "console.log(\"id salvo em {{id}}: \" + pessoa.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"66048764707\",\n  \"nome\": \"Maria Silva\",\n  \"idade\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pessoas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pessoas"
              ]
            },
            "description": "Cadastra a primeira pessoa e guarda o id retornado na variavel de collection {{id}}."
          },
          "response": []
        },
